# ── Shell / VM settings ──────────────────────────────────────────────────────
SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=ai-agent
SSH_KEY_PATH=~/.ssh/ai_vm_key
# SSH_PASSWORD=           # fallback if not using key auth
SSH_TIMEOUT=10
COMMAND_TIMEOUT=30

# VM auto-setup (optional — only used when VirtualBox is installed)
VM_NAME=ai-webshell
VM_RAM=2048
VM_CPUS=2
VM_DISK=30720
VM_PASS=changeme123
ISO_PATH=~/debian-13.4.0-amd64-netinst.iso
NETWORK_MODE=nat   # hostonly | nat | bridged
HOST_ONLY_IF=vboxnet0
SHARED_FOLDER=~/vm-share
VM_SUDO=false           # grant passwordless sudo to the VM user (default: false)
SEARXNG_PORT=8889       # SearXNG port inside the VM (also forwarded to host in NAT mode)

# ── Web / SearXNG settings ──────────────────────────────────────────────────
# Override SearXNG URL (default: auto-detected from VM)
# SEARXNG_URL=http://localhost:8889

# Request timeouts in seconds
# SEARXNG_TIMEOUT=30
# FETCH_TIMEOUT=30

# Proxies for web fetching — comma-separated, rotated randomly per request
# Supports http://, https://, socks5://  (with optional user:pass auth)
# FETCH_PROXIES=http://user:pass@host:port,socks5://host:port
