# Backend selection: auto (default) | local | remote
# - local:  execute directly in this process (server runs INSIDE Colab)
# - remote: talk to a colab_shell_client.bridge over HTTP (server runs on your
#           laptop, bridge runs in Colab)
# - auto:   remote when COLAB_BRIDGE_URL is set, otherwise local
COLAB_MODE=auto

# Remote backend: the bridge URL and token printed by the Colab bridge cell.
# For a cloud provider (OpenAI/xAI) this must be an https:// tunnel URL.
# The token is the ONLY thing gating an arbitrary-shell endpoint on a public
# tunnel: keep it secret, use >=16 chars, and rotate it if it may have leaked.
COLAB_BRIDGE_URL=
COLAB_BRIDGE_TOKEN=
COLAB_BRIDGE_VERIFY_TLS=true
CONNECT_TIMEOUT=30

# Per-command timeout in seconds.
COMMAND_TIMEOUT=1200

# MCP server transport/bind. Leave COLAB_MCP_TRANSPORT empty to auto-detect
# (http from a terminal/Colab, stdio when spawned by an MCP client).
COLAB_MCP_TRANSPORT=
COLAB_MCP_HOST=127.0.0.1
COLAB_MCP_PORT=9630

# fetch_file's local download server.
FILE_SERVER_HOST=127.0.0.1
FILE_SERVER_PORT=9631
FILES_DIR=~/mcp-files
