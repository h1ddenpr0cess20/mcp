# For real device over WiFi
ADB_HOST=192.168.1.x
ADB_PORT=5555

# For USB device or emulator, leave blank (auto-detect)
ADB_SERIAL=

# Screenshot save path on host
SCREENSHOT_DIR=/tmp/android_screenshots

# Command timeout in seconds
ADB_TIMEOUT=30

# HTTPS file server for serving screenshots
FILE_SERVER_HOST=127.0.0.1
FILE_SERVER_PORT=9701
FILES_DIR=~/mcp-files
CERT_DIR=~/.android_mcp_certs
