# Where the blog keeps its data: the SQLite database, uploaded images, and the
# secrets it generates (password, API token, session key). Created owner-only (0700).
BLOG_DIR=~/mcp-blog

# Name and tagline shown at the top of every page
BLOG_TITLE=Private Blog
BLOG_DESCRIPTION=

# Where the blog listens
BLOG_HOST=127.0.0.1
BLOG_PORT=9901

# Hostnames the HTTP app will accept. Add your public domain when using a reverse proxy.
# Avoid '*' on an internet-facing blog.
BLOG_ALLOWED_HOSTS=127.0.0.1,localhost

# Your login. The blog never stores your password, only a salted hash of it. On the first start from a
# terminal it generates one and shows it once. To choose your own, run (then restart the blog):
#   python blog_mcp/blog/blog.py set-password
BLOG_USERNAME=owner
# To set the password through the environment instead, prefer a hash so no plain text is in this file:
#   python blog_mcp/blog/blog.py hash-password
# BLOG_PASSWORD_HASH=
# BLOG_PASSWORD=

# Token the MCP server (or any tool) uses to manage posts through the API.
# Leave unset to generate one into $BLOG_DIR/api_token
# BLOG_API_TOKEN=

# false: everything needs a login (private blog).
# true: published posts are readable by anyone; drafts, the editor and the API stay protected.
BLOG_PUBLIC=false

# Address to use in links returned by the API, if the blog is reached through a proxy
# BLOG_PUBLIC_URL=https://blog.example.com

# HTTPS (set both). Use this if you change BLOG_HOST away from 127.0.0.1,
# otherwise logins cross the network in clear text. Or run behind an HTTPS reverse proxy.
# BLOG_TLS_CERT=~/certs/blog.pem
# BLOG_TLS_KEY=~/certs/blog.key
