# Where the blog is stored: the SQLite database, plus the generated viewer
# password if BLOG_PASSWORD is unset. Created owner-only (0700) if it doesn't exist.
BLOG_DIR=~/mcp-blog

# Name and tagline shown at the top of every viewer page
BLOG_TITLE=Private Blog
BLOG_DESCRIPTION=

# Viewer: the web page you read the blog on. Every request needs a password.
BLOG_HOST=127.0.0.1
BLOG_PORT=9901
BLOG_USERNAME=owner
# Leave unset to generate a random password once and keep it in $BLOG_DIR/viewer_password
# BLOG_PASSWORD=

# Optional HTTPS for the viewer (set both). Use this if you change BLOG_HOST away
# from 127.0.0.1, otherwise the password crosses the network in clear text.
# BLOG_TLS_CERT=~/certs/blog.pem
# BLOG_TLS_KEY=~/certs/blog.key
