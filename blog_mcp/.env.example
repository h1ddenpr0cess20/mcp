# Where the blog is. The blog is a separate program: start it with `python blog_mcp/blog/blog.py`.
BLOG_URL=http://127.0.0.1:9901

# The blog's API token. Leave unset when the blog runs on this computer with the default
# storage folder; the token is then read from $BLOG_DIR/api_token.
# BLOG_API_TOKEN=
# BLOG_DIR=~/mcp-blog

# Seconds to wait for the blog to answer
BLOG_TIMEOUT=30

# Set to false only to accept a self-signed HTTPS certificate
BLOG_VERIFY_TLS=true
