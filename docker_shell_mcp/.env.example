DOCKER_COMMAND=docker
DOCKER_CONTAINER=shell-mcp-sandbox
DOCKER_IMAGE=shell-mcp-sandbox:latest
DOCKER_HOSTNAME=shell-sandbox
DOCKER_WORKDIR=/workspace
DOCKER_USER=root
DOCKER_NETWORK=bridge
DOCKER_MEMORY=2g
DOCKER_CPUS=2
DOCKER_PIDS_LIMIT=512
DOCKER_VOLUME=shell-mcp-data
DOCKER_REMOVE_ON_EXIT=false
COMMAND_TIMEOUT=1200

FILE_SERVER_HOST=127.0.0.1
FILE_SERVER_PORT=9621
FILES_DIR=~/mcp-files
