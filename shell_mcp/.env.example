SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=ai-agent
SSH_KEY_PATH=~/.ssh/ai_vm_key
# SSH_PASSWORD=           # fallback if not using key auth
SSH_TIMEOUT=10
COMMAND_TIMEOUT=1200

# VM auto-setup (optional — only used when VirtualBox is installed)
USE_VM=true             # set to false to skip the VM and connect directly via SSH
VM_NAME=ai-sandbox
VM_RAM=2048
VM_CPUS=2
VM_DISK=30720
VM_PASS=changeme123
# ISO_PATH=~/debian-13.6.0-amd64-netinst.iso   # default: latest netinst in ~
# ISO_URL=https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/debian-13.6.0-amd64-netinst.iso
NETWORK_MODE=nat   # hostonly | nat | bridged
HOST_ONLY_IF=vboxnet0
SHARED_FOLDER=~/vm-share
VM_SUDO=false           # grant passwordless sudo to the VM user (default: false)
