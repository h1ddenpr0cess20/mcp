# LLM endpoint (LM Studio default)
SUBAGENT_BASE_URL=http://localhost:1234/v1
SUBAGENT_API_KEY=lm-studio

# Default model (leave unset to use whatever's loaded on the endpoint)
# SUBAGENT_DEFAULT_MODEL=

# Limits
SUBAGENT_MAX_TOKENS=4000
SUBAGENT_TIMEOUT=2000
SUBAGENT_TEMPERATURE=0.7

# Parallelism (leave unset to auto-detect on first parallel call)
# SUBAGENT_MAX_WORKERS=3

# MCP servers available to agents (comma-separated name=url pairs)
# SUBAGENT_MCP_SERVERS=web=http://127.0.0.1:9510/mcp,shell=http://127.0.0.1:9610/mcp,android=http://127.0.0.1:9700/mcp
