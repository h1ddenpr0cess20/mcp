# Fire TV device connection
FIRETV_HOST=192.168.1.100
FIRETV_PORT=5555

# ADB timeout in seconds (default: 10)
ADB_TIMEOUT=10

# File server (for screenshots)
FILE_SERVER_HOST=127.0.0.1
FILE_SERVER_PORT=9815
FILES_DIR=~/firetv-mcp-files
CERT_DIR=~/.firetv_mcp_certs

# Optional: custom app aliases (JSON object)
# APP_ALIASES={"myapp": "com.example.myapp"}
